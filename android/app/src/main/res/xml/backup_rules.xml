<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: the same rule as data_extraction_rules.xml (the stored server address and access token stay off backups). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
</full-backup-content>
