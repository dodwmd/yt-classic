# Get a key: see README.md ("Getting a YouTube Data API key").
# Copy this file to .env and fill it in. .env is git-ignored.
YT_API_KEY=

# Optional
# AUDIO_LANG=en        # preferred audio-track language for dubbed videos
# PORT=3000
# DATA_DIR=./data      # subscriptions.json lives here

# Optional shared access token. Unset = anyone who can reach the port can use the app.
# Generate one with: openssl rand -hex 24   (never commit a real value)
# ACCESS_TOKEN=
